# Server
LOG_LEVEL=INFO
DEBUG=False
WORKERS=4

# API
API_HOST=0.0.0.0
API_PORT=9897
HTTP_PATH_PREFIX=/auth

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE_SSO=sso

# JWT
SECRET_KEY=changeme_use_a_long_random_string
SSO_ALGORITHM=HS256

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Multiple client IDs (iOS + Android + Web) — comma-separated:
# OAUTH2_GOOGLE_CLIENT_ID=id1.apps.googleusercontent.com,id2.apps.googleusercontent.com
OAUTH2_APPLE_BUNDLE_ID=com.yourcompany.yourapp

# SMS provider: mock | twilio | whatsapp | telegram
SMS_PROVIDER=mock

# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp (if SMS_PROVIDER=whatsapp)
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# Telegram (if SMS_PROVIDER=telegram)
TELEGRAM_BOT_TOKEN=

# Verification
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL=300
VERIFICATION_MAX_ATTEMPTS=5

# Dev only — fixed OTP code (only works when DEBUG=True)
# DEV_FIXED_OTP_CODE=123456
